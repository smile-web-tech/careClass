{
  "expo": {
    "name": "ClassCare",
    "slug": "classcare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "classcare",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F4F7FB",
    "ios": {
      "bundleIdentifier": "com.smiletechweb.classcare",
      "supportsTablet": false,
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.smiletechweb.classcare",
      "adaptiveIcon": {
        "backgroundColor": "#2457E8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.READ_CONTACTS"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-contacts",
        {
          "contactsPermission": "ClassCare reads your contacts so you can add a student without retyping their name and number."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C1729",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ca3d6823-e765-4977-8c33-f61099342e30"
      }
    },
    "owner": "smiletechweb2"
  }
}
