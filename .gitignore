# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Local module build output. Gradle regenerates all of it, and EAS builds from
# the git archive — so committing it only made every build upload a megabyte of
# stale Kotlin caches.
modules/*/android/build/
modules/*/android/.gradle/

# Local secrets
.env
.env.local

# Firebase *service account* keys — a real private key, and the one thing here
# that must never be committed. Held only as the FCM_SERVICE_ACCOUNT Supabase
# secret and in EAS credentials.
*-firebase-adminsdk-*.json
service-account*.json

# NOTE: google-services.json is deliberately NOT ignored. It is client config,
# not a credential — every value in it ships inside the APK already, and the
# API key it carries is restricted to this package name plus SHA-1. More to the
# point, EAS uploads the build from git: ignoring the file means the builder
# never receives it, and `app.json` names it, so the build fails.

# Claude Code local state. Accumulates approved shell commands verbatim,
# which means pasted tokens end up here. Never share.
.claude/

# Supabase CLI link state
supabase/.temp/
