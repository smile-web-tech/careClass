# Copy to `.env` and fill in. Everything prefixed EXPO_PUBLIC_ is compiled into
# the app bundle and is therefore public — never put a secret key here.
#
# Dashboard → Project Settings → Data API (URL) and → API Keys (publishable).

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Google Cloud -> Credentials -> the **Web** client id (not the Android one).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxx.apps.googleusercontent.com

# ---------------------------------------------------------------------------
# SERVER ONLY — do not add these to .env. Set them with:
#   supabase secrets set NAME=value
#
#   (SUPABASE_URL / _ANON_KEY / _SERVICE_ROLE_KEY are injected automatically)
#   RESEND_API_KEY        re_...          (email, set)
#   RESEND_FROM           "ClassCare <notifications@smiletech.dev>"   REQUIRED —
#                         without it the function refuses to send, because the
#                         onboarding@resend.dev fallback only reaches the Resend
#                         account owner and silently rejects everyone else.
#   RESEND_REPLY_TO       a mailbox the teacher actually reads
#   RESEND_INBOUND_DOMAIN reply.smiletech.dev   turns on tokenised Reply-To so
#                         replies land in the app's inbox — see docs/replies.md
#   RESEND_WEBHOOK_SECRET whsec_...       signs the inbound webhook
#
#   SMS_PROVIDER          twilio | telnyx | eskiz   (default twilio)
#     twilio:  TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM
#     telnyx:  TELNYX_API_KEY, TELNYX_FROM
#     eskiz:   ESKIZ_EMAIL, ESKIZ_PASSWORD, ESKIZ_SENDER  (Uzbekistan only)
# ---------------------------------------------------------------------------
